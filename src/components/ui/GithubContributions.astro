---
import { getContributions, type GitHubContribution } from "@/services/github";
import { site } from "@/data/site";

import Label from "@/components/ui/Label.astro";

interface Props {
    username?: string;
}

const { username = site.social.github.split("/").pop() } = Astro.props as Props;

const data = await getContributions(username!);

type Day = { date: string; count: number; level: number; outside: boolean };
type Month = { index: number; label: string; key: string } | null;

const MONTHS = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];

const LEVEL_CLASSES = [
    "bg-primary/50",
    "bg-foreground/40",
    "bg-foreground/65",
    "bg-foreground/90",
    "bg-foreground",
];

function addDays(iso: string, days: number) {
    const d = new Date(Date.parse(iso + "T00:00:00Z") + days * 86400000);
    return d.toISOString().slice(0, 10);
}

function getUTCDay(iso: string) {
    return new Date(Date.parse(iso + "T00:00:00Z")).getUTCDay();
}

function getUTCMonth(iso: string) {
    return new Date(Date.parse(iso + "T00:00:00Z")).getUTCMonth();
}

function buildCalendar(contributions: GitHubContribution[]) {
    if (contributions.length === 0) return { weeks: [] as Day[][], months: [] as Month[] };

    const byDate = new Map<string, GitHubContribution>();
    for (const c of contributions) byDate.set(c.date, c);

    const firstIso = contributions[0].date;
    const lastIso = contributions[contributions.length - 1].date;

    const weeks: Day[][] = [];
    const months: Month[] = [];

    let cursor = addDays(firstIso, -getUTCDay(firstIso));

    while (cursor <= lastIso) {
        const week: Day[] = [];
        for (let i = 0; i < 7; i++) {
            const iso = cursor;
            const c = byDate.get(iso);
            week.push({
                date: iso,
                count: c?.count ?? 0,
                level: c?.level ?? 0,
                outside: iso < firstIso || iso > lastIso,
            });
            cursor = addDays(cursor, 1);
        }
        weeks.push(week);

        const firstOfMonth = week.find((day) => !day.outside && day.date.endsWith("-01"));
        if (firstOfMonth) {
            months.push({ index: getUTCMonth(firstOfMonth.date), label: MONTHS[getUTCMonth(firstOfMonth.date)], key: firstOfMonth.date.slice(0, 7) });
        } else {
            const firstDay = week.find((day) => !day.outside);
            if (months.length === 0 && firstDay) {
                months.push({ index: getUTCMonth(firstDay.date), label: MONTHS[getUTCMonth(firstDay.date)], key: firstDay.date.slice(0, 7) });
            } else {
                months.push(null);
            }
        }
    }

    const daysPerMonth = new Map<string, number>();
    for (const day of weeks.flat()) {
        if (day.outside) continue;
        const key = day.date.slice(0, 7);
        daysPerMonth.set(key, (daysPerMonth.get(key) ?? 0) + 1);
    }

    for (let i = months.length - 1; i >= 0; i--) {
        const m = months[i];
        if (m) {
            if ((daysPerMonth.get(m.key) ?? 0) < 7) months[i] = null;
            break;
        }
    }

    return { weeks, months };
}

const { weeks, months } = buildCalendar(data.contributions);

---


{data.contributions.length > 0 && (
    <div class="w-full">
        <div class="flex flex-wrap items-center md:justify-between md:mb-3">
            <Label>GitHub Contributions</Label>
            <span class="text-xs text-foreground/60 w-full md:w-auto">{data.total} contributions in the past 365 days</span>
        </div>

        <div class="gh-grid mx-auto w-fit max-w-full pt-4 md:pt-8 pb-1 overflow-x-auto md:overflow-visible">
            <div class="inline-flex flex-col">
                <div
                    class="relative mb-1 h-5"
                    style={`width: calc(var(--gh-cell, 10px) * ${weeks.length} + var(--gh-gap, 4px) * ${weeks.length - 1})`}
                >
                    {months.map((m, i) =>
                        m ? (
                            <span
                                class="absolute top-0 text-[9px] leading-none text-foreground/50"
                                style={`left: calc(var(--gh-cell, 10px) * ${i} + var(--gh-gap, 4px) * ${i})`}
                            >
                                {m.label}
                            </span>
                        ) : null
                    )}
                </div>

                <div class="grid" style={`gap: var(--gh-gap, 4px); grid-auto-flow: column; grid-template-rows: repeat(7, var(--gh-cell, 10px)); grid-auto-columns: var(--gh-cell, 10px);`}>
                    {weeks.flatMap((week) =>
                        week.map((day) => (
                            <span
                                class={`gh-cell rounded-xs ${day.outside ? "bg-transparent" : LEVEL_CLASSES[day.level] ?? LEVEL_CLASSES[0]}`}
                                {...(day.outside ? {} : { "data-tip": `${day.count} contrib. · ${day.date}` })}
                            />
                        ))
                    )}
                </div>
            </div>
        </div>

        <div class="mt-2 flex items-center md:justify-end gap-1.5 text-[10px] text-foreground/50">
            <span>Less</span>
            {LEVEL_CLASSES.map((cls) => (
                <span class={`gh-cell rounded-xs ${cls}`} />
            ))}
            <span>More</span>
        </div>
    </div>
)}
