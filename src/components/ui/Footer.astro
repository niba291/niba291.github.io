---
import Section from "@/components/ui/Section.astro";
import Label from "@/components/ui/Label.astro";
import Link from "@/components/ui/Link.astro";

import { footer } from "@/data";

---

<footer class="bg-background mx-3 mb-3 rounded-b-2xl pb-10">
    <Section class="min-h-auto! border-t border-border pt-12!">
        <div class="grid grid-cols-2 gap-4 pb-1">
            <Label size="sm" class="text-end">
                crafted By
            </Label>
            <Link href={footer.craftedBy.href} target="_blank" class="text-sm">
                {footer.craftedBy.name}
            </Link>
        </div>
        <div class="grid grid-cols-2 gap-4 py-1">
            <Label size="sm" class="text-end">
                Source Code
            </Label>
            <Link href={footer.sourceCode[0].href} target="_blank" class="text-sm">
                {footer.sourceCode[0].name}
            </Link>
        </div>
        <div class="grid grid-cols-2 gap-4 py-1">
            <Label size="sm" class="text-end">
                Inspired by
            </Label>
            <div class="flex flex-col gap-1">
                {footer.inspiredBy.map((item) => (
                    <Link href={item.href} target="_blank" class="text-sm">
                        {item.name}
                    </Link>
                ))}
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4 py-1">
            <Label size="sm" class="text-end">
                Deployed on
            </Label>
            <div class="flex flex-col gap-1">
                {footer.deployedOn.map((item) => (
                    <Link href={item.href} target="_blank" class="text-sm">
                        {item.name}
                    </Link>
                ))}
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4 py-1">
            <Label size="sm" class="text-end">
                License
            </Label>
            <Link href={footer.license.href} target="_blank" class="text-sm">
                {footer.license.name}
            </Link>
        </div>
    </Section>
</footer>