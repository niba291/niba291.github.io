---
export interface Props {
    type?: "button" | "submit" | "reset";
    variant?: "primary" | "outline" | "ghost";
    size?: "xs" | "sm" | "md" | "lg";
    disabled?: boolean;
    class?: string;
    href?: string;
    rel?: string;
    download?: boolean;
    target?: "_self" | "_blank" | "_parent" | "_top";
}

const { 
    type = "button",
    variant = "primary",
    size = "md",
    disabled = false,
    class: className = "",
    href,
} = Astro.props as Props;

const variants = {
    primary: "bg-foreground text-background border border-foreground hover:bg-primary hover:text-foreground",
    outline: "border border-foreground text-foreground hover:bg-foreground/10",
    ghost: "text-foreground hover:bg-foreground/10",
};

const sizes = {
    xs: "px-2.5 py-1 text-xs",
    sm: "px-3 py-1.5 text-sm",
    md: "px-4 py-2 text-sm",
    lg: "px-6 py-3 text-base",
};

const stateClasses = disabled ? "opacity-50 cursor-not-allowed" : "cursor-pointer";

const Tag = href ? "a" : "button";
---

<Tag
    {...Astro.props}
    type={type}
    disabled={disabled}
    class={`inline-flex items-center justify-center gap-1.5 rounded-full font-medium transition-colors ${variants[variant]} ${sizes[size]} ${stateClasses} ${className}`.trim()}
>
    <slot />
</Tag>
