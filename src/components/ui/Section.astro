---
import Title from "@/components/ui/Title.astro";
import Text from "@/components/ui/Text.astro";
import Badge from "@/components/ui/Badge.astro";

export interface Props {
    class?: string;
    id?: string;
    title?: string;
    badge?: string;
    badgeIcon?: string;
    description?: string;
};

const { 
    class: className = "", 
    id = "",
    title = "",
    badge = "",
    badgeIcon = "mdi:hexagon-multiple",
    description = ""
} = Astro.props as Props;
---

<section id={id} class={`relative min-h-full overflow-hidden z-10 mx-auto max-w-7xl px-4 pt-26 pb-12 sm:px-6 lg:px-8 ${className}`.trim()}>
    {(title !== "") && (
        <div class="flex flex-col gap-4 mb-16 items-center text-center">
            <Badge icon={badgeIcon}>
                {badge}
            </Badge>
            <Title as="h2">
                {title}
            </Title>
            <Text size="lg" class="max-w-xl">
                {description}
            </Text>
        </div>
    )}
    <slot />
</section>

