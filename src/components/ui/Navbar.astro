---
import { Icon } from "astro-icon/components";

import Corner from "@/components/ui/Corner.astro";
import Button from "@/components/ui/Button.astro";
import Dropdown from "@/components/ui/Dropdown.astro";

import { navLinks } from "@/data/site";
---

<header class="sticky top-0 z-50 -mt-30 text-background">
    <div class="hidden md:flex flex-wrap justify-center">
        <div class="w-full py-1.5 bg-foreground"/>
        <Corner corners="lt rt" line="transparent"/>
        <nav class=" p-4 items-center justify-center bg-foreground rounded-b-2xl">
            <ul class="flex items-center gap-4">
                {navLinks.map((link) => (
                    <li>
                        <Button href={link.href} aria-label={link.label} class="nav-link rounded-full p-2! data-active:bg-background data-active:text-foreground">
                            <Icon name={link.icon} class="size-6"/>
                        </Button>
                    </li>
                ))}
                <li>
                    <Dropdown id="dpd-desktop-settings">
                        <Fragment slot="trigger">
                            <Icon name="solar:settings-bold" class="size-6"/>
                        </Fragment>
                        <Fragment slot="menu">
                            <div class="flex justify-center gap-2">
                                <Button data-theme-toggle="light" aria-label="Toggle light theme" class="rounded-full p-2! data-active:bg-background data-active:text-foreground">
                                    <Icon name="solar:sun-2-bold" class="size-6"/>
                                </Button>
                                <Button data-theme-toggle="dark" aria-label="Toggle dark theme" class="rounded-full p-2! data-active:bg-background data-active:text-foreground">
                                    <Icon name="solar:moon-bold" class="size-6"/>
                                </Button>
                            </div>
                        </Fragment>
                    </Dropdown>
                </li>
            </ul>
        </nav>    
        <Corner corners="lt rt" line="transparent"/>
    </div>

    <div id="mobile-menu" class="fixed bottom-0 inset-x-0 z-50 md:hidden">
        <div class="flex flex-wrap">
            <div class="flex flex-wrap justify-between mx-2.5 -mb-0.5 w-full">
                <Corner corners="rb" class="ml-0!"/>
                <Corner corners="lb" class="mr-0!"/>
            </div>
            <nav class="w-full bg-foreground px-2 py-2 rounded-t-2xl">
                <ul class="flex flex-row gap-6 items-center justify-center">
                    {navLinks.map((link) => (
                        <li>
                            <Button href={link.href} aria-label={link.label} class="nav-link rounded-full p-2! data-active:bg-background data-active:text-foreground">
                                <Icon name={link.icon} class="size-6"/>
                            </Button>
                        </li>
                    ))}
                    <li>
                        <Dropdown id="dpd-mobile-settings">
                            <Fragment slot="trigger">
                                <Icon name="solar:settings-bold" class="size-6"/>
                            </Fragment>
                            <Fragment slot="menu">
                                <div class="flex justify-center gap-2">
                                    <Button data-theme-toggle="light" aria-label="Toggle light theme" class="rounded-full p-2! data-active:bg-background data-active:text-foreground">
                                        <Icon name="solar:sun-2-bold" class="size-6"/>
                                    </Button>
                                    <Button data-theme-toggle="dark" aria-label="Toggle dark theme" class="rounded-full p-2! data-active:bg-background data-active:text-foreground">
                                        <Icon name="solar:moon-bold" class="size-6"/>
                                    </Button>
                                </div>
                            </Fragment>
                        </Dropdown>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>

<script>
    const links = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const ids = Array.from(links).map((a) => a.getAttribute("href")?.slice(1)).filter((id): id is string => id !== undefined);
    const sections = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);

    const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

    const setActiveTheme = (theme: string) => {
        themeButtons.forEach((button) => {
            button.toggleAttribute("data-active", button.dataset.themeToggle === theme);
        });
    };

    let currentTheme = document.documentElement.dataset.theme ?? "light";
    setActiveTheme(currentTheme);

    themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
            currentTheme = button.dataset.themeToggle ?? "light";
            document.documentElement.dataset.theme = currentTheme;
            localStorage.setItem("theme", currentTheme);
            setActiveTheme(currentTheme);
        });
    });

    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    links.forEach((link) => {
                        const href = link.getAttribute("href")?.slice(1);
                        link.toggleAttribute("data-active", href === id);
                    });
                }
            }
        },
        { rootMargin: "-40% 0px -55% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
</script>