---

import { Icon } from "astro-icon/components";

const navLinks = [
    { label: "Inicio", href: "#inicio" },
    { label: "Proyectos", href: "#proyectos" },
    { label: "Experiencia", href: "#experiencia" },
    { label: "Certificados", href: "#certificados" },
];
---

<header class="sticky top-0 z-50 text-foreground m-auto">
    <!-- https://www.google.com/search?q=clip+css+generator&oq=clip+css+generator&gs_lcrp=EgRlZGdlKgYIABBFGDkyBggAEEUYOdIBCDM3ODFqMGo3qAIAsAIA&sourceid=chrome&source=chrome.ob&ie=UTF-8#fpstate=ive&vld=cid:ac3dcd85,vid:yXN6MT4ERbE,st:0 -->
    <nav class="mx-auto px-4 py-3 flex items-center justify-center">
        <ul class="hidden md:flex items-center gap-8">
            {navLinks.map((link) => (
                <li>
                    <a href={link.href} class="transition-colors duration-300 font-body text-sm tracking-wide">
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>

        <button id="menu-toggle" class="md:hidden cursor-pointer">
            <Icon name="line-md:menu" width="26" height="26"/>
        </button>
    </nav>

    <div id="mobile-menu" class="md:hidden hidden bg-foreground border-t border-border/10 px-4 py-4">
        <ul class="flex flex-col gap-4 items-center">
            {navLinks.map((link) => (
                <li>
                    <a href={link.href} class="transition-colors duration-300 font-body text-lg">
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</header>

<script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    toggle?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
    });

    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            menu.classList.add("hidden");
        });
    });
</script>