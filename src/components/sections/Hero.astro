---
import Section from "@/components/ui/Section.astro";
import Title from "@/components/ui/Title.astro";
import GithubContributions from "@/components/ui/GithubContributions.astro";

import { site } from "@/data/site";

const sectionId = "home";

---
<Section id={sectionId} class="flex flex-wrap h-screen">    
    <div class="flex flex-col space-y-8 m-auto w-1/2">
        <Title as="h1" size="xl">
            {site.name}
        </Title>
        <Title size="lg">
            {site.role}
        </Title>
    </div>
    <div class="flex flex-col space-y-8 m-auto w-1/2">
        <img
            src={site.profileImage}
            alt="Profile picture"
            class="rounded-full size-50 md:size-80 object-cover mx-auto border-2 border-foreground"
        />
    </div>
    <div class="flex flex-col space-y-8 m-auto md:w-2/3">
        <GithubContributions/>
    </div>
</Section>