---
import { Icon } from "astro-icon/components";

import Section from "@/components/ui/Section.astro";
import Carrousel from "@/components/ui/Carrousel.astro";
import Card from "@/components/ui/Card.astro";
import Text from "@/components/ui/Text.astro";
import Badge from "@/components/ui/Badge.astro";
import Label from "@/components/ui/Label.astro";

import { experience } from "@/data";

const sectionId = "experiences";
---

<Section
    id={sectionId}
    badge="Experiencia"
    badgeIcon="solar:case-bold"
    title="Trayectoria profesional"
    description="Años de experiencia construyendo soluciones full stack para distintas empresas."
>
    <Carrousel>
        {experience.map((item) => (
            <Card
                class="embla__slide"
                schema
                title={item.company}
                titleClass="max-w-40 md:max-w-100"
                bodyClass="p-6 pt-1 justify-between"
            >
                <Fragment slot="header">
                    <Label size="xs" class="rounded-t-2xl rounded-br-none text-background! px-3 text-center bg-foreground ml-auto mr-3">
                        {item.title.split("|")[0]}<br>
                        {item.title.split("|")[1]}
                    </Label>
                </Fragment>

                <details class="group" data-expand>
                    <div class="relative">
                        <div class="max-h-40 overflow-hidden transition-[max-height] duration-500 ease-in-out group-open:max-h-[40rem] md:max-h-none">
                            {item.description.map((line) => (
                                <Text size="sm" class="text-bold!">
                                    {line}
                                </Text>
                            ))}
                        </div>
                        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-primary to-transparent transition-opacity duration-500 group-open:opacity-0 md:hidden"></div>
                    </div>
                    <summary class="list-none cursor-pointer select-none [&::-webkit-details-marker]:hidden [&::marker]:hidden md:hidden">
                        <span class="flex items-center justify-center gap-1.5 mt-3 text-sm font-semibold text-foreground">
                            <span class="group-open:hidden">Ver más</span>
                            <span class="hidden group-open:inline">Ver menos</span>
                            <Icon name="solar:alt-arrow-down-bold" class="size-4 transition-transform duration-300 group-open:rotate-180"/>
                        </span>
                    </summary>
                </details>

                <div class="flex flex-wrap gap-1 mt-4 items-end">
                    {item.tags.map((tag) => (
                        <Badge class="text-xs">
                            # {tag}
                        </Badge>
                    ))}
                </div>
            </Card>
        ))}
    </Carrousel>
</Section>

<style>
    @media (min-width: 768px) {
        details[data-expand]:not([open]) > div {
            display: block;
        }
    }
</style>
