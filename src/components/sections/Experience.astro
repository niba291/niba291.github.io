---
import { Icon } from "astro-icon/components";

import Section from "@/components/ui/Section.astro";
import Carrousel from "@/components/ui/Carrousel.astro";
import Card from "@/components/ui/Card.astro";
import Text from "@/components/ui/Text.astro";
import Badge from "@/components/ui/Badge.astro";
import Label from "@/components/ui/Label.astro";
import Button from "@/components/ui/Button.astro";
import Modal from "@/components/ui/Modal.astro";
import Title from "@/components/ui/Title.astro";

import { experience } from "@/data";

const sectionId = "experiences";
---

<Section
    id={sectionId}
    badge="Experiencia"
    badgeIcon="solar:case-bold"
    title="Trayectoria profesional"
    description="Años de experiencia construyendo soluciones full stack para distintas empresas."
>
    <Carrousel>
        {experience.map((item) => {
            const [
                title,
                date
            ] = item.title.split("|");
            return (
                <Card
                    class="embla__slide"
                    schema
                    group
                    title={item.company}
                    titleClass="max-w-40 md:max-w-100"
                    bodyClass="relative p-6 pt-1 justify-between max-h-80! min-h-80! md:max-h-100! md:min-h-100!"
                >
                    <Fragment slot="header">
                        <Label size="xs" class="rounded-t-2xl rounded-br-none text-background! px-3 text-center bg-foreground ml-auto mr-3">
                            {title}<br>
                            {date}
                        </Label>
                    </Fragment>

                    <div class="absolute left-4 right-4 top-2 md:top-10 h-[67%] group-hover:-top-5 z-10 transition-[top] duration-500 ease-in-out flex flex-col gap-2 bg-background p-4 border border-border rounded-md overflow-hidden">
                        {item.description.map((line) => (
                            <Text size="sm" class="text-bold!">
                                {line}
                            </Text>
                        ))}
                    </div>
                    <div class="absolute z-20 flex flex-col bg-primary w-[calc(100%+0.25rem)] p-4 gap-1 top-[33.55%] left-0 border-2 border-border rounded-2xl -ml-0.5 h-[67%]">
                        <div class="mx-auto">
                            <Button size="sm" variant="ghost" class="flex-1" data-modal-open={`md-experience-${item.company}`}>
                                <Icon name="solar:arrow-up-bold"/>
                                Ver más
                            </Button>
                        </div>
                        <div class="mt-auto mb-0">
                            {item.tags.map((tag) => (
                                <Badge class="text-xs">
                                    # {tag}
                                </Badge>
                            ))}
                        </div>
                    </div>
                    <Modal id={`md-experience-${item.company}`}>
                        <Fragment slot="title">
                            <div class="w-[95%] flex flex-wrap gap-2">
                                <Title size="sm" class="w-full md:pl-1">
                                    {item.company}
                                </Title>
                                <Badge class="text-xs!">{item.title}</Badge>
                            </div>
                        </Fragment>
                        <div class="flex flex-col gap-4">
                            {item.description.map((line) => (
                                <Text size="sm" class="text-bold!">
                                    {line}
                                </Text>
                            ))}
                        </div>
                    </Modal>
                </Card>
            );
        })}
    </Carrousel>
</Section>
