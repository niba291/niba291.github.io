---
import { Icon } from "astro-icon/components";

import Section from "@/components/ui/Section.astro";
import Title from "@/components/ui/Title.astro";
import Text from "@/components/ui/Text.astro";
import Badge from "@/components/ui/Badge.astro";
import Label from "@/components/ui/Label.astro";

import { experience } from "@/data";

const sectionId = "experiences";

const jobs = experience.map((job) => {
    const [role = job.title, period = ""] = job.title.split("|").map((part) => part.trim());
    return { ...job, role, period };
});
---

<Section
    id={sectionId}
    badge="Experiencia"
    badgeIcon="line-md:briefcase"
    title="Trayectoria profesional"
    description="Años de experiencia construyendo soluciones full stack para distintas empresas."
>
    <ol class="relative ms-4 sm:ms-8 space-y-10 border-s-2 border-foreground/15 ps-8 sm:ps-12">
        {jobs.map((job) => (
            <li class="relative">
                <span class="absolute -inset-s-11 sm:-inset-s-15 top-1.5 flex size-7 items-center justify-center rounded-full bg-foreground text-background">
                    <Icon name="line-md:briefcase-filled" class="size-4"/>
                </span>

                <article class="rounded-2xl border border-foreground/15 bg-white/40 p-5 sm:p-6 shadow-sm">
                    <div class="flex flex-wrap items-center gap-2">
                        <Icon name="line-md:account" class="size-5 text-primary"/>
                        <Label size="sm" as="span" class="text-primary">
                            {job.company}
                        </Label>
                    </div>

                    <Title as="h3" size="md" class="mt-2">
                        {job.role}
                    </Title>

                    {job.period !== "" && (
                        <div class="mt-1 flex items-center gap-1.5">
                            <Icon name="line-md:calendar" class="size-4 text-foreground/50"/>
                            <Text size="sm" as="span">
                                {job.period}
                            </Text>
                        </div>
                    )}

                    <ul class="mt-4 space-y-2">
                        {job.description.map((point : string) => (
                            <li class="flex items-start gap-2">
                                <Icon name="line-md:confirm-circle" class="mt-1 size-4 shrink-0 text-secondary"/>
                                <Text class="flex-1">
                                    {point.replace(/^•\s*/, "")}
                                </Text>
                            </li>
                        ))}
                    </ul>

                    <div class="mt-5 flex flex-wrap gap-2">
                        {job.tags.map((tag) => (
                            <Badge icon="line-md:hash">
                                {tag}
                            </Badge>
                        ))}
                    </div>
                </article>
            </li>
        ))}
    </ol>
</Section>
