---
import { site } from "@/data";

import Navbar from "@/components/ui/Navbar.astro";
import Footer from "@/components/ui/Footer.astro";
import Loader from "@/components/ui/Loader.astro";

import "@/styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={site.description} />
	<script>
		const savedTheme = localStorage.getItem("theme");
		const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
		if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
			document.documentElement.dataset.theme = "dark";
		}
	</script>
	<title>{site.title}</title>
</head>
<body class="bg-foreground">
	<div id="page-loader" class="fixed inset-0 z-100 flex items-center justify-center bg-background">
		<Loader class="size-24 md:size-32"/>
	</div>
	<div class="bg-background py-3 mt-3 mx-3 rounded-t-2xl"/>
	<main class="bg-background mx-3 pt-2.5 -mt-1">
		<Navbar/>
		<slot/>
	</main>
	<Footer/>
</body>
</html>

<script>
	window.addEventListener("load", () => {
		const loader = document.getElementById("page-loader");
		if (!loader) return;
		loader.style.opacity = "0";
		loader.style.transition = "opacity 0.5s ease";
		setTimeout(() => loader.remove(), 600);
	});
</script>
