---
import { site } from "@/data";

import Navbar from "@/components/ui/Navbar.astro";
import Footer from "@/components/ui/Footer.astro";
import Loader from "@/components/ui/Loader.astro";

import "@/styles/global.css";

const { title = site.title, description = site.description } = Astro.props;
const canonical = Astro.url.origin + Astro.url.pathname;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			name: site.name,
			url: canonical,
			inLanguage: "es",
		},
		{
			"@type": "Person",
			name: site.name,
			jobTitle: site.role,
			url: canonical,
			image: site.profileImage,
			sameAs: [site.social.github, site.social.linkedin],
		},
	],
};
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={description} />
	<link rel="canonical" href={canonical} />

	<meta property="og:type" content="website" />
	<meta property="og:site_name" content={site.name} />
	<meta property="og:locale" content="es_CL" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonical} />
	<meta property="og:image" content={site.profileImage} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={site.profileImage} />

	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

	<script>
		const savedTheme = localStorage.getItem("theme");
		const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
		if (savedTheme === "dark") {
			document.documentElement.dataset.theme = "dark";
		}
	</script>
	<title>{title}</title>
</head>
<body class="bg-foreground">
	<div id="page-loader" class="fixed inset-0 z-100 flex items-center justify-center bg-background">
		<Loader class="size-24 md:size-32"/>
	</div>
	<div class="bg-background py-3 mt-3 mx-3 rounded-t-2xl"/>
	<main class="bg-background mx-3 pt-2.5 -mt-1">
		<Navbar/>
		<slot/>
	</main>
	<Footer/>
</body>
</html>

<script>
	window.addEventListener("load", () => {
		const loader = document.getElementById("page-loader");
		if (!loader) return;
		loader.style.opacity = "0";
		loader.style.transition = "opacity 0.5s ease";
		setTimeout(() => loader.remove(), 600);
	});
</script>
